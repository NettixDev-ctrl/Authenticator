post_install() {
  update-desktop-database -q /usr/share/applications 2>/dev/null || true
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  echo ":: Приложение установлено. Запуск: material-authenticator"
  echo ":: Ключи хранятся локально в ~/.config/material-authenticator/accounts.json (права 0600)."
}

post_upgrade() {
  post_install
}

post_remove() {
  update-desktop-database -q /usr/share/applications 2>/dev/null || true
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  echo ":: Ваши ключи в ~/.config/material-authenticator/ НЕ удалены."
  echo ":: Удалите вручную, если они больше не нужны."
}
